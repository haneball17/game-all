<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{B7F6838A-8FFC-4A5C-A21D-DC0B8F14352E}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>gamepayload</RootNamespace>
    <ProjectName>game-payload</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- 统一输出目录 -->
    <RepoRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)\..'))</RepoRoot>
    <RustWorkspaceDir>$(RepoRoot)rust\</RustWorkspaceDir>
    <RustTargetTriple>i686-pc-windows-msvc</RustTargetTriple>
    <RustProfile Condition="'$(Configuration)'=='Debug'">debug</RustProfile>
    <RustProfile Condition="'$(Configuration)'=='Release'">release</RustProfile>
    <RustBuildArgs Condition="'$(Configuration)'=='Debug'">build -p game_payload_core --target $(RustTargetTriple)</RustBuildArgs>
    <RustBuildArgs Condition="'$(Configuration)'=='Release'">build -p game_payload_core --target $(RustTargetTriple) --release</RustBuildArgs>
    <RustLibDir>$(RustWorkspaceDir)target\$(RustTargetTriple)\$(RustProfile)\</RustLibDir>
    <OutDir>$(RepoRoot)artifacts\bin\payload\</OutDir>
    <IntDir>$(RepoRoot)artifacts\obj\payload\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(RustWorkspaceDir)include;$(ProjectDir)lib\minhook\build\VC17\include;$(ProjectDir)lib\minhook\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_DEBUG;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(RustLibDir);$(ProjectDir)lib\minhook\lib;$(ProjectDir)lib\minhook\lib\Release;$(ProjectDir)lib\minhook\build\VC17\lib\$(Configuration);$(ProjectDir)lib\minhook\build\VC17\lib\Release;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>game_payload_core.lib;libMinHook.x86.lib;user32.lib;ole32.lib;Ws2_32.lib;Userenv.lib;Ntdll.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(RustWorkspaceDir)include;$(ProjectDir)lib\minhook\build\VC17\include;$(ProjectDir)lib\minhook\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(RustLibDir);$(ProjectDir)lib\minhook\lib;$(ProjectDir)lib\minhook\build\VC17\lib\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>game_payload_core.lib;libMinHook.x86.lib;user32.lib;ole32.lib;Ws2_32.lib;Userenv.lib;Ntdll.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="pch.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp" />
    <ClCompile Include="dllmain.cpp" />
    <ClCompile Include="modules\helper\HelperMod.cpp" />
    <ClCompile Include="modules\sync\SyncMod.cpp" />
  </ItemGroup>
  <Target Name="BuildRustPayloadCore" BeforeTargets="ClCompile">
    <Message Text="构建 Rust payload core: cargo $(RustBuildArgs)" Importance="high" />
    <Exec Command="cargo $(RustBuildArgs)" WorkingDirectory="$(RustWorkspaceDir)" />
  </Target>
  <Target Name="PostBuildCopyToRun" AfterTargets="Build">
    <PropertyGroup>
      <RepoRoot>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)\..'))</RepoRoot>
      <RunDir>$(RepoRoot)artifacts\run\</RunDir>
      <RunConfigDir>$(RunDir)config\</RunConfigDir>
      <ConfigTemplatesDir>$(RepoRoot)config-templates\</ConfigTemplatesDir>
    </PropertyGroup>
    <ItemGroup>
      <RunOutputFiles Include="$(TargetDir)*.*" />
    </ItemGroup>
    <MakeDir Directories="$(RunDir)" />
    <MakeDir Directories="$(RunConfigDir)" />
    <Copy SourceFiles="@(RunOutputFiles)" DestinationFolder="$(RunDir)" SkipUnchangedFiles="true" />
    <Exec Command="xcopy /D /Y &quot;$(ConfigTemplatesDir)*.*&quot; &quot;$(RunConfigDir)&quot; &gt;nul" Condition="Exists('$(ConfigTemplatesDir)')" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
